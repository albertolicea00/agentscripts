# sync/.env.example
# ─────────────────────────────────────────────────────────────
# Used by:  pull.sh / push.sh  (local machine / CI)
# NOT used by pull.ipynb / push.ipynb — those read Colab Secrets instead.
#
# Setup:
#   cp sync/.env.example sync/.env   (or: make setup)
#   fill in values below
#   sync/.env is gitignored — never commit it
# ─────────────────────────────────────────────────────────────

# Google Drive folder ID
# From the URL: drive.google.com/drive/folders/<ID>
DRIVE_FOLDER_ID=your_drive_folder_id_here

# GitHub personal access token (repo scope)
GITHUB_TOKEN=your_github_token_here

# GitHub username
GITHUB_USER=albertolicea00

# Repo name
GITHUB_REPO=agentscripts

# Local repo root (used by .sh scripts)
LOCAL_REPO_PATH=./

# Path to Google service account JSON (for .sh scripts)
# The service account needs Drive API access (roles/drive.file or roles/drive.readonly)
GOOGLE_APPLICATION_CREDENTIALS=sync/service_account.json

# ─────────────────────────────────────────────────────────────
# Colab Secrets (for pull.ipynb / push.ipynb)
# Set these in the Colab left panel under 🔑 Secrets — NOT here.
#
# Key name              Value
# ────────────────────  ───────────────────────────────────────
# DRIVE_FOLDER_ID       same as above
# GITHUB_TOKEN          same as above
# GITHUB_USER           albertolicea00
# GITHUB_REPO           agentscripts
# ─────────────────────────────────────────────────────────────

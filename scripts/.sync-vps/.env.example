# scripts/.sync-vps/.env.example
# ─────────────────────────────────────────────────────────────
# Used by pull.sh / push.sh to sync scripts/ with a remote VPS.
# Copy to .sync-vps/.env and fill in — .env is gitignored.
# ─────────────────────────────────────────────────────────────

# VPS connection
VPS_HOST=your.vps.ip.or.domain
VPS_USER=root
VPS_PORT=22

# Path on VPS where scripts are stored
VPS_SCRIPTS_PATH=/opt/agentscripts/scripts

# SSH key to use (leave blank to use default ~/.ssh/id_rsa)
SSH_KEY=~/.ssh/id_rsa

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_USER=albertolicea00
GITHUB_REPO=agentscripts

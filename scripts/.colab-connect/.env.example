# Configuration for Google Colab SSH Connection (.colab-connect)

# Path to your private SSH key
SSH_KEY="${HOME}/.ssh/id_rsa"

# Remote user on Colab (always root on standard Google Colab)
COLAB_USER="root"

# Active Cloudflare tunnel hostname (e.g. random-subdomain.trycloudflare.com)
# Leave empty if you prefer to pass it as argument to connect.sh or enter when prompted.
COLAB_HOST=""
